#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<MainScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.13, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(15)

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Label:
                text: "Metal OCR Scanner"
                font_size: sp(20)
                bold: True
                color: 0.2, 0.85, 1, 1
                halign: 'left'
                text_size: self.width, None

        # Image Preview Area
        RelativeLayout:
            size_hint_y: 0.4
            canvas.before:
                Color:
                    rgba: 0.12, 0.13, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15)]
            
            Image:
                id: preview_image
                allow_stretch: True
                keep_ratio: True
            
            Label:
                id: no_image_label
                text: "Upload or Scan an Image"
                font_size: sp(16)
                color: 0.4, 0.45, 0.55, 1

        # Result Display
        BoxLayout:
            size_hint_y: None
            height: dp(80)
            orientation: 'vertical'
            spacing: dp(5)
            
            Label:
                id: result_number
                text: "---"
                font_size: sp(28)
                bold: True
                color: 0.2, 0.9, 0.55, 1
                halign: 'center'
                text_size: self.width, None

            BoxLayout:
                size_hint_y: None
                height: dp(20)
                Label:
                    id: engine_label
                    text: "Ready"
                    font_size: sp(12)
                    color: 0.5, 0.55, 0.65, 1
                    halign: 'left'
                    text_size: self.width, None
                Label:
                    id: confidence_label
                    text: "0%"
                    font_size: sp(12)
                    color: 0.5, 0.55, 0.65, 1
                    halign: 'right'
                    text_size: self.width, None

            ProgressBar:
                id: confidence_bar
                value: 0
                max: 100
                size_hint_y: None
                height: dp(8)

        # Suggestions
        ScrollView:
            size_hint_y: None
            height: dp(40)
            do_scroll_y: False
            BoxLayout:
                id: suggestions_chips
                size_hint_x: None
                width: self.minimum_width
                spacing: dp(10)

        # Action Buttons
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            
            Button:
                text: "Upload"
                background_normal: ''
                background_color: 0.2, 0.25, 0.35, 1
                color: 1, 1, 1, 1
                bold: True
                on_press: app.open_file_picker()

            Button:
                id: scan_btn
                text: "SCAN NUMBER"
                background_normal: ''
                background_color: 0.15, 0.65, 0.45, 1
                color: 1, 1, 1, 1
                bold: True
                on_press: app.run_ocr()

        # Bottom Nav & Comparison
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: dp(10)
            
            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Method 1"
                    font_size: sp(10)
                    color: 0.5, 0.55, 0.65, 1
                Label:
                    id: tess_result
                    text: "---"
                    font_size: sp(14)
                    bold: True
                    color: 0.8, 0.8, 0.8, 1

            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Method 2"
                    font_size: sp(10)
                    color: 0.5, 0.55, 0.65, 1
                Label:
                    id: easy_result
                    text: "---"
                    font_size: sp(14)
                    bold: True
                    color: 0.8, 0.8, 0.8, 1

            Button:
                text: "History"
                size_hint_x: 0.3
                background_normal: ''
                background_color: 0.2, 0.6, 1, 1
                color: 1, 1, 1, 1
                bold: True
                on_press: app.go_to_history()

<HistoryScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.13, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(15)

        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Button:
                text: "< Back"
                size_hint_x: 0.2
                background_normal: ''
                background_color: 0.3, 0.35, 0.45, 1
                on_press: app.go_to_main()
            Label:
                text: "Scan History"
                font_size: sp(20)
                bold: True
                color: 0.2, 0.85, 1, 1
            Label:
                id: total_label
                text: "0 records"
                font_size: sp(14)
                color: 0.5, 0.55, 0.65, 1
                size_hint_x: 0.3

        ScrollView:
            BoxLayout:
                id: history_list
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
